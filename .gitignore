# Local environments, tool caches and Python byproducts
/.venv*/
/.tools/
**/__pycache__/
*.py[cod]
*.egg-info/
**/build/
**/dist/

# CAD runtime state and logs
cad/gs8-d2-v1/.cad.lock
*.log
# Bound run logs tracked on purpose (their sha256 is recorded by a committed receipt; review 2026-10-12 PUB-3)
!cad/gs8-d2-v1/candidate-vertical/corrective-2026-10-12/fxh-regression.log
!cad/gs8-d2-v1/candidate-vertical/guide/out-concealed-vents/post-guide-build-order-check.log
# Followup check-run logs recorded by out/compact-kowa_lm6hc/review-check-run.json and the harness refresh log
# bound by review-2026-10-12-followup/harness-refresh.json (review 2026-10-13 R-10); sha256 in check-logs/LOG-SHA256.json
!cad/gs8-d2-v1/candidate-vertical/out/compact-kowa_lm6hc/check-logs/*.log
!cad/gs8-d2-v1/candidate-vertical/review-2026-10-12-followup/harness-refresh.log

# Bulky or regenerable local material (git history replaces the baseline zips)
*.zip
*.npz
cad/gs8-d2-v1/candidate-fr1/out/
cad/gs8-d2-v1/out/_*/
!cad/gs8-d2-v1/out/_fujinon-cloud-polish-20261007/

# Manufacturer drawings and datasheet page images used during research stay local (third-party copyright)
cad/gs8-d2-v1/research/m12-drawings/
cad/gs8-d2-v1/research/r5-lens-support/*.png

# guide mesh cache (rebuilt by guide/build_guide.py --remesh)
cad/gs8-d2-v1/guide/_cache/

# Vertical review caches: regenerate tessellations and page images from source/STEP.
cad/gs8-d2-v1/candidate-vertical/out/*/meshes/
cad/gs8-d2-v1/candidate-vertical/guide/out/
cad/gs8-d2-v1/candidate-vertical/guide/out-concealed-vents/page-*.png
cad/gs8-d2-v1/candidate-vertical/guide/out-concealed-vents/figures/
cad/gs8-d2-v1/candidate-vertical/guide/*.so
cad/gs8-d2-v1/candidate-vertical/guide/raster
# Nonselected hero/service pictures remain in the complete review archive.
cad/gs8-d2-v1/candidate-vertical/vent-study/angled-channel-trial/renders/hero.png
cad/gs8-d2-v1/candidate-vertical/vent-study/angled-channel-trial/renders/rear.png
cad/gs8-d2-v1/candidate-vertical/history/reviewed-export18/renders/*.png

# Fontconfig cache generated by document rendering.
cad/var/cache/fontconfig/
